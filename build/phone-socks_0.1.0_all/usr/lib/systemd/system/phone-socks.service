[Unit]
Description=phone-socks — 폰 모바일 데이터를 노트북 인터넷 회선으로 중계
Documentation=file:///usr/share/doc/phone-socks/README.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/phone-socksd
# 데몬이 어떤 이유로 멈추든 방화벽 규칙은 반드시 지운다.
# 규칙만 남으면 사용자의 인터넷이 통째로 끊긴다.
ExecStopPost=-/usr/sbin/nft delete table inet phonesocks
Restart=on-failure
RestartSec=3

User=phonesocks
Group=phonesocks
SupplementaryGroups=plugdev

# root 전체가 아니라 네트워크 조작 능력만 준다
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

RuntimeDirectory=phone-socks
RuntimeDirectoryMode=0755
StateDirectory=phone-socks
ConfigurationDirectory=phone-socks

ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/phone-socks
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
