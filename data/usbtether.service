[Unit]
Description=USBTether — 폰 모바일 데이터를 노트북 인터넷 회선으로 중계
Documentation=file:///usr/share/doc/usbtether/README.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/usbtetherd
# 데몬이 어떤 이유로 멈추든 방화벽 규칙은 반드시 지운다.
# 규칙만 남으면 사용자의 인터넷이 통째로 끊긴다.
ExecStopPost=-/usr/sbin/nft delete table inet usbtether
ExecStopPost=-/usr/sbin/ip link del usbt0
Restart=on-failure
RestartSec=3

# polkit 은 uid 0 인 호출자만 다른 프로세스의 권한을 확인할 수 있으므로
# 데몬은 root 로 돈다. 대신 root 가 가질 수 있는 능력을 아래 셋으로만 제한한다.
# CAP_DAC_OVERRIDE 가 빠져 있어 파일 권한을 무시하지도 못한다.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

RuntimeDirectory=usbtether
RuntimeDirectoryMode=0755
StateDirectory=usbtether
ConfigurationDirectory=usbtether
# adb 가 쓸 수 있는 HOME. ProtectHome 때문에 /root 는 보이지 않는다.
Environment=HOME=/var/lib/usbtether

# tmpfs: /home 과 /root 를 빈 임시 파일시스템으로 덮는다.
# yes 로 완전히 막으면 snap 클라이언트가 /root/.snap 에 쓰지 못해 갱신 보류가 실패한다.
# 사용자 데이터가 보이지 않는 것은 마찬가지다.
ProtectHome=tmpfs
ProtectSystem=strict
ReadWritePaths=/etc/usbtether
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
